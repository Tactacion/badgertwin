// Candidate site for a rented chiller (assumed).
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type TempChillerSite schema name "BT_TEMP_CHILLER_SITE" {
  siteId: string
  nearBuildingId: string
  nearBuilding: string
  lat: double
  lon: double
  maxUnits: int
  unitTonsOptions: string
  generatorKwPerUnit: int
  setupCostUsd: int
  dataOrigin: string
}
