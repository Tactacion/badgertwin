// Real Madison weather + modelled campus load factor.
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type WeatherHour schema name "BT_WEATHER_HOUR" {
  timestamp: datetime
  outdoorTempF: double
  dewPointF: double
  campusLoadFactor: double
  modelledCampusDemandTons: double
}
