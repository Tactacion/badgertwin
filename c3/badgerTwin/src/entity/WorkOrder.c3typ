// Maintenance history (simulated, plus the real 1980 and 2026 events).
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type WorkOrder schema name "BT_WORK_ORDER" {
  workOrderId: string
  assetId: string
  type: string
  priority: string
  opened: datetime
  closed: datetime
  costUsd: double
  preventive: boolean
  dataOrigin: string
}
