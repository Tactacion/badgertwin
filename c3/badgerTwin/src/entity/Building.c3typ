// A campus building served by chilled water (public list + estimated loads).
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type Building schema name "BT_BUILDING" {
  buildingId: string
  name: string
  uwBuildingNumber: double
  status2026: string
  use: string
  affected2026: boolean
  lat: double
  lon: double
  footprintM2: int
  levels: double
  estGsf: int
  designCoolingTons: int
  criticalityWeight: int
  maxIndoorTempF: int
  patientCare: boolean
  animalResearch: boolean
  locationSource: string
  dataOrigin: string
}
