// A reported dollar figure with its quote.
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type CostFact schema name "BT_COST_FACT" {
  factId: string
  amountUsd: double
  amountText: string
  whatItIs: string
  dateReported: string
  sourceUrl: string
  quote: string
  verified: boolean
  notes: string
}
