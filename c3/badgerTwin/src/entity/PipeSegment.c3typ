// A chilled-water pipe segment. Routes are approximate.
// Generated by scripts/export_c3_package.py from the BadgerTwin dataset.
entity type PipeSegment schema name "BT_PIPE_SEGMENT" {
  pipeId: string
  fromNode: string
  toNode: string
  lengthFt: int
  diameterIn: int
  role: string
  installYear: int
  material: string
  depthFt: double
  soil: string
  inTunnel: boolean
  routeConfidence: string
  dataOrigin: string
}
